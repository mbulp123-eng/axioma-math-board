{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axioma-math-board",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-22",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "vars": { "ALLOWED_ORIGIN": "https://mbulp123-eng.github.io" },
  "ratelimits": [
    { "name": "AI_RATE_LIMITER", "namespace_id": "1942101", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": false }
}
